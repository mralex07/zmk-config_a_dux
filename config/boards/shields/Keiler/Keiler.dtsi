#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &keiler_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <36>;
        rows = <1>;
        map = <
        RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)    RC(0,22) RC(0,21) RC(0,20) RC(0,19) RC(0,18)
        RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)    RC(0,27) RC(0,26) RC(0,25) RC(0,24) RC(0,23)
        RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)   RC(0,32) RC(0,31) RC(0,30) RC(0,29) RC(0,28)
                          RC(0,15) RC(0,16) RC(0,17)   RC(0,35) RC(0,34) RC(0,33)
        >;
    };

    kscan0: kscan { };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&glidepoint_split>;
    };

    keiler_layout: keiler_layout {
        compatible = "zmk,physical-layout";
        display-name = "Keiler";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys
            = <&key_physical_attrs 100 100   11  172 (-1500)    61   222>
            , <&key_physical_attrs 100 100  129   42  (-500)   179    92>
            , <&key_physical_attrs 100 100  248    0       0     0     0>
            , <&key_physical_attrs 100 100  368   33     500   418    83>
            , <&key_physical_attrs 100 100  464   59     500   514   109>
            , <&key_physical_attrs 100 100  800   59  (-500)   850   109>
            , <&key_physical_attrs 100 100  896   33  (-500)   946    83>
            , <&key_physical_attrs 100 100 1016    0       0     0     0>
            , <&key_physical_attrs 100 100 1135   42     500  1185    92>
            , <&key_physical_attrs 100 100 1253  172    1500  1303   222>

            , <&key_physical_attrs 100 100   35  265 (-1500)    85   315>
            , <&key_physical_attrs 100 100  137  139  (-500)   187   189>
            , <&key_physical_attrs 100 100  248   97       0     0     0>
            , <&key_physical_attrs 100 100  360  130     500   410   180>
            , <&key_physical_attrs 100 100  456  155     500   506   205>
            , <&key_physical_attrs 100 100  808  155  (-500)   858   205>
            , <&key_physical_attrs 100 100  904  130  (-500)   954   180>
            , <&key_physical_attrs 100 100 1016   97       0     0     0>
            , <&key_physical_attrs 100 100 1127  139     500  1177   189>
            , <&key_physical_attrs 100 100 1229  265    1500  1279   315>

            , <&key_physical_attrs 100 100   59  359 (-1500)   109   409>
            , <&key_physical_attrs 100 100  145  236  (-500)   195   286>
            , <&key_physical_attrs 100 100  248  194       0     0     0>
            , <&key_physical_attrs 100 100  352  227     500   402   277>
            , <&key_physical_attrs 100 100  448  252     500   498   302>
            , <&key_physical_attrs 100 100  816  252  (-500)   866   302>
            , <&key_physical_attrs 100 100  912  227  (-500)   962   277>
            , <&key_physical_attrs 100 100 1016  194       0     0     0>
            , <&key_physical_attrs 100 100 1119  236     500  1169   286>
            , <&key_physical_attrs 100 100 1205  359    1500  1255   409>

            , <&key_physical_attrs 100 100  340  342    1000   390   392>
            , <&key_physical_attrs 100 100  436  389    2000   486   439>
            , <&key_physical_attrs 100 100  532  436    3000   582   486>
            , <&key_physical_attrs 100 100  732  436 (-3000)   782   486>
            , <&key_physical_attrs 100 100  828  389 (-2000)   878   439>
            , <&key_physical_attrs 100 100  924  342 (-1000)   974   392>
            ;
    };

};
