#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {

    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &keiler_layout;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <36>;
        rows = <1>;
        map = <
        RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)    RC(0,22) RC(0,21) RC(0,20) RC(0,19) RC(0,18)
        RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)    RC(0,27) RC(0,26) RC(0,25) RC(0,24) RC(0,23)
        RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14)   RC(0,32) RC(0,31) RC(0,30) RC(0,29) RC(0,28)
                          RC(0,15) RC(0,16) RC(0,17)   RC(0,35) RC(0,34) RC(0,33)
        >;
    };

    kscan0: kscan { };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        glidepoint_split: glidepoint_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    glidepoint_listener: glidepoint_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
        device = <&glidepoint_split>;
    };

    keiler_layout: keiler_layout {
        compatible = "zmk,physical-layout";
        display-name = "Keiler";
        transform = <&default_transform>;
        kscan = <&kscan0>;

        keys
            = <&key_physical_attrs 100 100 000 000 0 0 0>
            , <&key_physical_attrs 100 100 100 000 0 0 0>
            , <&key_physical_attrs 100 100 200 000 0 0 0>
            , <&key_physical_attrs 100 100 300 000 0 0 0>
            , <&key_physical_attrs 100 100 400 000 0 0 0>
            , <&key_physical_attrs 100 100 700 000 0 0 0>
            , <&key_physical_attrs 100 100 800 000 0 0 0>
            , <&key_physical_attrs 100 100 900 000 0 0 0>
            , <&key_physical_attrs 100 100 1000 000 0 0 0>
            , <&key_physical_attrs 100 100 1100 000 0 0 0>

            , <&key_physical_attrs 100 100 000 100 0 0 0>
            , <&key_physical_attrs 100 100 100 100 0 0 0>
            , <&key_physical_attrs 100 100 200 100 0 0 0>
            , <&key_physical_attrs 100 100 300 100 0 0 0>
            , <&key_physical_attrs 100 100 400 100 0 0 0>
            , <&key_physical_attrs 100 100 700 100 0 0 0>
            , <&key_physical_attrs 100 100 800 100 0 0 0>
            , <&key_physical_attrs 100 100 900 100 0 0 0>
            , <&key_physical_attrs 100 100 1000 100 0 0 0>
            , <&key_physical_attrs 100 100 1100 100 0 0 0>

            , <&key_physical_attrs 100 100 000 200 0 0 0>
            , <&key_physical_attrs 100 100 100 200 0 0 0>
            , <&key_physical_attrs 100 100 200 200 0 0 0>
            , <&key_physical_attrs 100 100 300 200 0 0 0>
            , <&key_physical_attrs 100 100 400 200 0 0 0>
            , <&key_physical_attrs 100 100 700 200 0 0 0>
            , <&key_physical_attrs 100 100 800 200 0 0 0>
            , <&key_physical_attrs 100 100 900 200 0 0 0>
            , <&key_physical_attrs 100 100 1000 200 0 0 0>
            , <&key_physical_attrs 100 100 1100 200 0 0 0>

            , <&key_physical_attrs 100 100 300 300 0 0 0>
            , <&key_physical_attrs 100 100 400 300 0 0 0>
            , <&key_physical_attrs 100 100 500 300 0 0 0>
            , <&key_physical_attrs 100 100 600 300 0 0 0>
            , <&key_physical_attrs 100 100 700 300 0 0 0>
            , <&key_physical_attrs 100 100 800 300 0 0 0>
            ;
    };

};
